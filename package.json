{
  "name": "supabase-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright API and PostgreSQL comparison tests for Supabase",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:connection": "node scripts/check-connection.js",
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "dotenv": "18.0.10",
    "pg": "8.23.1"
  }
}
