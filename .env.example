# Fill in .env locally. Never paste passwords or secret keys into chat.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Settings > API Keys > Secret keys. Backend tests only; bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Connect > Session pooler > URI. Replace the password placeholder.
# Percent-encode special characters in your database password.
# Copy the actual host/username from the dashboard; do not guess them.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Optional: Database settings > SSL > Download certificate, saved locally.
# If your TLS connection needs Supabase's root certificate, uncomment:
# DATABASE_CA_PATH=./certs/prod-ca.crt
